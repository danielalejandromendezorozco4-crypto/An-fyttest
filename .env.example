# ==============================================================================
# VARIABLES DE ENTORNO REQUERIDAS PARA AN-FYT
# ==============================================================================
# Clave de la API oficial de Finnhub (https://finnhub.io/)
# Requerida para perfiles de empresas, cotizaciones, velas históricas, métricas y noticias.
FINNHUB_API_KEY=tu_finnhub_api_key_aqui

# Clave de Google Gemini AI (https://aistudio.google.com/)
# Requerida para generación de análisis macroeconómico y perfiles de investigación institucional.
GEMINI_KEY=tu_gemini_key_aqui

# Clave de FRED - Federal Reserve Economic Data (https://fred.stlouisfed.org/)
# Requerida para tasa libre de riesgo (bono del tesoro a 10 años DGS10) y spreads de crédito.
FRED_KEY=tu_fred_key_aqui
